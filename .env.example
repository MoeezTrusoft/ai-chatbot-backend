APP_ENV=dev
APP_NAME=bookcraft-chatbot
APP_HOST=0.0.0.0
APP_PORT=8000
READINESS_CHECK_EXTERNALS=false
LANGUAGE_GUARD_ENABLED=true

DATABASE_URL=postgresql+asyncpg://bookcraft:bookcraft_dev@localhost:55432/bookcraft
DATABASE_REPLICA_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Local Docker host bindings.
# Keep DOCKER_BIND_HOST=127.0.0.1 for local development so infra ports are not exposed
# on the LAN. Only change this deliberately for controlled lab access.
DOCKER_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379
ELASTICSEARCH_HOST_PORT=9200
TEI_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_PROM_HOST_PORT=8889
LOKI_HOST_PORT=3100
GRAFANA_ADMIN_PASSWORD=admin


REDIS_URL=redis://localhost:6379/0
REDIS_HOT_TTL_HOURS=24
REDIS_IDEMPOTENCY_TTL_HOURS=24
REDIS_RELATION_CACHE_TTL_HOURS=24

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=bookcraft_

TEI_URL=http://localhost:8080
TEI_TIMEOUT_SECONDS=10
TEI_BATCH_SIZE=128
TEI_DEGRADED_MODE_ENABLED=true
EMBEDDING_DIMENSIONS=384

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INTENT_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=http://deepseek-internal:8000/v1
DEEPSEEK_INTENT_MODEL=deepseek-chat
LLM_PROVIDER_MODE=mock
LLM_REQUEST_TIMEOUT_SECONDS=8.0

NDA_MODE=manual
AGREEMENT_MODE=manual
NDA_TEMPLATE_VERSION=v1.0
AGREEMENT_TEMPLATE_VERSION=v1.0
DOCUMENT_TEMPLATE_DIR=data/templates
DOCUMENT_OUTPUT_DIR=data/generated/documents
DOCUMENT_PDF_RENDERING_ENABLED=false
DOCUMENT_RETRACTION_HOURS=24
S3_DOCUMENTS_BUCKET=bookcraft-documents
S3_REGION=us-east-1
DOCUMENT_SIGNED_URL_TTL_HOURS=24

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=hello@bookcraft.ai
EMAIL_FROM_NAME=BookCraft AI

TRIMATCH_MODE=shadow
TRIMATCH_SHORTCUT_LAYERS=
TRIMATCH_SHORTCUT_THRESHOLD=0.95
TRIMATCH_AUTOCORRECT_ENABLED=false
TRIMATCH_AUTOAPPROVE_ENABLED=false
TRIMATCH_RULE_DIR=data/trimatch/rules
TRIMATCH_EVAL_DIR=data/trimatch/eval
TRIMATCH_FUNNEL_STAGE_WEIGHT=0
TRIMATCH_FUZZY_ENABLED=false

FUNNEL_SIGNAL_MODE=shadow
FUNNEL_RULE_SOURCE_PATH=data/funnel/funnel_stage_intents.sample.json
FUNNEL_RULE_BUILD_DIR=data/funnel/build
PREPROCESSOR_SIDECAR_DIR=data/trimatch/sidecars

RAG_TOP_K=8
RAG_MAX_TOKENS_PER_CHUNK=200
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_INDEX_ALIAS=bookcraft_rag_current
RAG_INDEX_VERSION=bookcraft_rag_v1
RAG_SOURCE_DIR=data/rag-corpus/source_markdown
RAG_BUILD_DIR=data/rag-corpus/build
RAG_STRICT_VERIFIER=true
PRICING_RULE_DIR=data/pricing
PRICING_STRICT_VERIFIER=true
PRICING_ALLOW_PLACEHOLDER_RULES=false
PRICING_QUOTE_VALID_DAYS=14
PRICING_ENGINE_VERSION=v2
PRICING_V2_CONFIG_DIR=data/pricing/v2
PRICING_V2_VALUES_APPROVED=false
PORTFOLIO_SAMPLES_REGISTRY_PATH=data/portfolio/samples.registry.js
PORTFOLIO_GENRE_HIERARCHY_PATH=data/portfolio/genre_hierarchy_links.json
PORTFOLIO_SAMPLES_DOCX_PATH=data/portfolio/portfolio_samples.docx
SONNET_MAX_TOKENS=600
HAIKU_MAX_TOKENS=2048
INTENT_ENSEMBLE_TIMEOUT_SECONDS=2.5
DEEPSEEK_TIMEOUT_SECONDS=4.0
SHARED_PROCESSOR_CACHE_SIZE=1000
TRG_HOT_NODES_LIMIT=24
TRG_COMPACT_KEEP=12
TRG_RELATION_FAST_PATH_THRESHOLD=0.85
TRG_COMPLIANCE_THRESHOLD_DEFAULT=0.62

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
METRICS_PUBLIC=false
METRICS_BEARER_TOKEN=
LOG_LEVEL=INFO
LOG_FORMAT=json

API_AUTH_MODE=off
JWT_SIGNING_KEY=
JWT_TTL_HOURS=24
JWT_ISSUER=
JWT_AUDIENCE=
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_IP_PER_MINUTE=30

# See docs/backend-hardening.md before production rollout.
CHAT_TURN_TIMEOUT_SECONDS=60
LLM_BOUNDED_TIMEOUTS_ENABLED=true
LLM_READ_TIMEOUT_GENERATION_SECONDS=20
LLM_READ_TIMEOUT_EXTRACTION_SECONDS=8
PROMPT_CACHE_ENABLED=true
EVENT_LOG_BATCHING_ENABLED=false
TRG_BACKGROUND_PERSIST_ENABLED=false
LLM_EXTRACTION_OVERLAP_ENABLED=false
TRIMATCH_EVENT_EVIDENCE_SUMMARY=false
RAG_VECTOR_SEARCH_MODE=exact
RAG_KNN_NUM_CANDIDATES=100
LLM_PRICE_PER_MILLION_TOKENS={}
CSR_NODE_API_URL=
CSR_NODE_API_TOKEN=

# Companion receiver: use the same service token (32+ random characters) on both services.
# Run: uvicorn bookcraft.receiver.main:app --host 0.0.0.0 --port 8000
CSR_OUTBOX_MAX_ATTEMPTS=12
REMINDER_SMTP_HOST=
REMINDER_SMTP_PORT=587
REMINDER_SMTP_USERNAME=
REMINDER_SMTP_PASSWORD=
REMINDER_SENDER_EMAIL=
EMBEDDING_MODEL_REVISION=default
EMBEDDING_PREPROCESSING_VERSION=1
TRACE_RETENTION_DAYS=30
CONVERSATION_RETENTION_DAYS=365
# Required to finish deletion when an external upload service owns manuscript files.
ATTACHMENT_CLEANUP_URL=
ATTACHMENT_CLEANUP_TOKEN=

# ERP Sales MCP integration. Standalone remains available for independent installs.
# See docs/sales-integration.md for credential rotation and the website bridge.
SALES_INTEGRATION_MODE=standalone
# SALES_MCP_URL=https://sales.internal.example/mcp
# SALES_MCP_INTERNAL_SECRET=replace-with-sales-configured-internal-secret
# SALES_SERVICE_JWT_FILE=/run/secrets/sales-service.jwt
# SALES_TENANT_ID=<Sales tenant UUID>
# SALES_ACTOR_ID=<stable ERP service user ID>
SALES_WEBSITE_SUBJECT=sales-website-bridge
SALES_TIMEOUT_SECONDS=30
