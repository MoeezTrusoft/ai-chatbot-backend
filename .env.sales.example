# Overlay these settings on your normal Chatbot staging/production configuration.
# The Chatbot DATABASE_URL is its own database, never the Sales database.
# Fill placeholders through the deployment secret store. Do not commit credentials.
SALES_INTEGRATION_MODE=erp_mcp
API_AUTH_MODE=jwt
JWT_SIGNING_KEY=<same-key-as-the-sales-website-site-botSigningKeyEnv>
# The current Sales website JWT does not carry issuer/audience claims.
JWT_ISSUER=
JWT_AUDIENCE=
SALES_MCP_URL=https://<trusted-sales-mcp-host>/mcp
SALES_MCP_INTERNAL_SECRET=<exact-sales-MCP_INTERNAL_SECRET>
SALES_SERVICE_JWT_FILE=/run/sales-identity/service.jwt
SALES_TENANT_ID=<verified-ERP-tenant-UUID>
SALES_ACTOR_ID=<stable-dedicated-ERP-service-user-ID>
SALES_WEBSITE_SUBJECT=sales-website-bridge
SALES_TIMEOUT_SECONDS=30
READINESS_CHECK_EXTERNALS=true
# Mount the token directory read-only; the issuer must atomically rotate the file.
# A Kubernetes subPath file mount will NOT track Secret rotation: mount the directory.
# Use a trusted HTTPS endpoint or a TLS proxy, not unencrypted cluster HTTP.
